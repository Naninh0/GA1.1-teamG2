    "def add(a,b):\n",
    "    return a + b\n",
    "\n",
    "def sum_list(values):\n",
    "    totaal = 0\n",
    "    for value in values:\n",
    "        totaal += value\n",
    "    return totaal\n",
    "\n"
   ]
